{
  "name": "comphub",
  "version": "0.0.0",
  "private": true,
  "description": "CompHub - collaborative virtual spaces platform",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "heroku-postbuild": "pnpm --filter @comphub/api build"
  }
}
