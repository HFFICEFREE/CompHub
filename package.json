{
  "name": "comphub",
  "version": "1.2.0",
  "private": true,
  "description": "CompHub - collaborative virtual spaces platform",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @comphub/core build && pnpm --parallel -r dev",
    "dev:offline": "node scripts/dev-offline.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @comphub/core build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @comphub/core build && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "heroku-postbuild": "pnpm --filter @comphub/core build && pnpm --filter @comphub/api build"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.5.0",
      "next>postcss": "^8.5.32",
      "@nestjs/cli>glob": "^14.0.4",
      "@typescript-eslint/typescript-estree>minimatch": "^11.0.8"
    }
  }
}
